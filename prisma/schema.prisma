generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  ADMIN
}

// The two independently bookable resources. The whole resort is rented
// exclusively per date/slot; the function hall can be booked on its own.
enum ResourceType {
  RESORT
  FUNCTION_HALL
}

// A booking occupies one or more "periods" of a date:
//   DAY       -> { day }
//   NIGHT     -> { night }
//   OVERNIGHT -> { day, night }  (blocks the whole date)
// Two bookings on the same resource + date conflict only if their
// period sets intersect. See src/lib/booking.ts for the rule.
enum BookingSlot {
  DAY
  NIGHT
  OVERNIGHT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            String             @id @default(cuid())
  name          String
  email         String             @unique
  passwordHash  String
  role          Role               @default(GUEST)
  createdAt     DateTime           @default(now())
  bookings      Booking[]
  pushSubs      PushSubscription[]
}

// A single browser/device that has opted in to web push notifications.
// One user may have several (phone, laptop, ...). Keyed by the push
// service endpoint, which is unique per device+browser.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Booking {
  id       String        @id @default(cuid())
  resource ResourceType  @default(RESORT)
  date     DateTime      @db.Date
  slot     BookingSlot
  status   BookingStatus @default(CONFIRMED)

  // Guest details captured by staff at reservation time. Rates are kept
  // external and are intentionally not stored or displayed here.
  guestName  String
  guestPhone String?
  guestEmail String?
  pax        Int?
  notes      String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resource, date])
}
