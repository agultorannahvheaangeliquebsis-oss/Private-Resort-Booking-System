generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUEST
  ADMIN
}

// The guest's coarse choice. Each slot maps to a default time window;
// once the owner confirms and enters exact times, availability is decided
// by the real interval overlap. See src/lib/booking.ts for the rule.
//   DAY       -> daytime
//   NIGHT     -> evening into the next morning
//   OVERNIGHT -> afternoon check-in to next-day checkout
enum BookingSlot {
  DAY
  NIGHT
  OVERNIGHT
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

// Where a booking originated: entered by staff on the dashboard, or
// submitted by a guest through the public request form.
enum BookingSource {
  STAFF
  GUEST
}

model User {
  id            String             @id @default(cuid())
  name          String
  email         String             @unique
  passwordHash  String
  role          Role               @default(GUEST)
  createdAt     DateTime           @default(now())
  bookings      Booking[]
  pushSubs      PushSubscription[]
}

// A single browser/device that has opted in to web push notifications.
// One user may have several (phone, laptop, ...). Keyed by the push
// service endpoint, which is unique per device+browser.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Booking {
  id String @id @default(cuid())
  // Check-in and check-out dates. For a single-day booking endDate == date.
  // A multi-day stay spans every date from `date` through `endDate`.
  date     DateTime      @db.Date
  endDate  DateTime      @db.Date
  slot     BookingSlot
  status   BookingStatus @default(CONFIRMED)
  source   BookingSource @default(STAFF)

  // Exact times ("HH:MM", 24h) the owner enters, usually when confirming a
  // request. Blank until then; availability falls back to the slot's default
  // window while empty. These drive case-by-case availability (e.g. a 2 PM
  // checkout leaves that night bookable).
  startTime String?
  endTime   String?

  // Whole-resort bookings may add the function hall with air-conditioning.
  // This carries an additional charge (kept external, not stored).
  functionHallAircon Boolean @default(false)

  // Guest details. Rates are kept external and intentionally not stored.
  guestName  String
  guestPhone String?
  guestEmail String?
  pax        Int?
  notes      String?

  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([endDate])
}
